# Contacto por Resend
RESEND_API_KEY=
CONTACT_TO=
MAIL_FROM=

# URL pública del sitio para canonical/SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexación
# Usar "true" solo cuando el despliegue de producción esté listo para indexarse.
ALLOW_INDEXING=false

# Fallback opcional de Web3Forms
WEB3FORMS_ACCESS_KEY=

# Alternativa soportada por el código.
# Usar con cuidado por el prefijo público NEXT_PUBLIC.
# NEXT_PUBLIC_WEB3FORMS_KEY=
